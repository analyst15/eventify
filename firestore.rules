rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRegistration(data) {
      return data.participationType is string && data.participationType.size() <= 64 &&
             data.firstName is string && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() <= 100 &&
             data.country is string && data.country.size() == 2 &&
             data.email is string && data.email.size() <= 150 &&
             data.phone is string && data.phone.size() <= 100 &&
             data.city is string && data.city.size() <= 100 &&
             data.address is string && data.address.size() <= 500 &&
             data.paymentStatus is string && data.paymentStatus.size() <= 30 &&
             (!data.keys().contains('selectedTicketId') || (data.selectedTicketId is string && data.selectedTicketId.size() <= 50)) &&
             (!data.keys().contains('paymentMethod') || (data.paymentMethod is string && data.paymentMethod.size() <= 50)) &&
             (!data.keys().contains('receiptNumber') || (data.receiptNumber is string && data.receiptNumber.size() <= 50)) &&
             (!data.keys().contains('amountPaid') || (data.amountPaid is int && data.amountPaid >= 0));
    }

    // Registrations Collection Match Gates
    match /registrations/{registrationId} {
      allow get: if isValidId(registrationId);
      allow list: if false;

      allow create: if isValidId(registrationId) &&
                      isValidRegistration(incoming()) &&
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time &&
                      incoming().paymentStatus == 'pending' &&
                      incoming().keys().hasAll([
                        'participationType', 'firstName', 'lastName', 'jobTitle',
                        'organization', 'country', 'email', 'phone', 'city', 'zipCode',
                        'address', 'website', 'areasOfInterest', 'proposedTopic',
                        'sessionSummary', 'preferredFormat', 'participationOpportunities',
                        'attendance', 'attachments', 'createdAt', 'updatedAt',
                        'paymentStatus'
                      ]);

      allow update: if isValidId(registrationId) &&
                      isValidRegistration(incoming()) &&
                      existing().paymentStatus != 'success' &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time &&
                      (
                        // Action 1: Checkout/Payment update (from Checkout page)
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'paymentStatus', 'selectedTicketId', 'paymentMethod',
                          'amountPaid', 'receiptNumber', 'updatedAt'
                        ]) ||
                        // Action 2: Form edit update (from Registration page)
                        (
                          incoming().email == existing().email &&
                          incoming().firstName == existing().firstName &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'participationType', 'lastName', 'jobTitle', 'organization',
                            'country', 'phone', 'city', 'zipCode', 'address', 'website',
                            'areasOfInterest', 'proposedTopic', 'sessionSummary', 'preferredFormat',
                            'participationOpportunities', 'attendance', 'attachments', 'updatedAt'
                          ])
                        )
                      );

      allow delete: if false;
    }
  }
}
